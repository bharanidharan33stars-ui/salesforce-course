{
  "name": "salesforce-learning-academy",
  "version": "1.0.0",
  "private": true,
  "description": "Salesforce Learning Academy - a mobile-first online learning platform for Salesforce CRM and Platform concepts.",
  "scripts": {
    "dev": "concurrently -n web,api -c blue,magenta \"npm:dev:frontend\" \"npm:dev:backend\"",
    "dev:frontend": "next dev -p 3000",
    "dev:backend": "npm --prefix backend run dev",
    "build": "next build",
    "start": "next start -p 3000",
    "lint": "next lint",
    "typecheck": "tsc --noEmit && npm --prefix backend run typecheck",
    "db:migrate": "npm --prefix backend run migrate",
    "db:seed": "npm --prefix backend run seed",
    "db:admin": "npm --prefix backend run create-admin",
    "db:reset": "npm --prefix backend run db:reset",
    "test": "npm --prefix backend run test && npm run test:frontend",
    "test:frontend": "vitest run --config vitest.config.ts",
    "setup": "npm install && npm --prefix backend install"
  },
  "dependencies": {
    "@gsap/react": "2.1.2",
    "@hookform/resolvers": "5.9.1",
    "argon2": "0.44.0",
    "cors": "2.8.6",
    "dotenv": "16.6.1",
    "express": "4.22.3",
    "express-rate-limit": "7.5.1",
    "express-session": "1.19.0",
    "framer-motion": "12.43.0",
    "gsap": "3.15.0",
    "helmet": "8.3.0",
    "lucide-react": "0.577.0",
    "mysql2": "3.24.6",
    "next": "15.5.27",
    "nodemailer": "7.0.13",
    "pdfkit": "0.20.2",
    "react": "19.1.9",
    "react-dom": "19.1.9",
    "react-hook-form": "7.90.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.3.3",
    "@testing-library/dom": "^10.4.0",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.5.2",
    "@types/node": "^24.0.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "concurrently": "10.0.6",
    "jsdom": "^26.0.0",
    "tailwindcss": "4.3.3",
    "typescript": "5.9.3",
    "vitest": "3.2.7"
  }
}
