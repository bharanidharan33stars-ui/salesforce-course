# ---------------------------------------------------------------
# Frontend environment (copy to .env.local and adjust)
# Only NEXT_PUBLIC_* values are ever sent to the browser.
# ---------------------------------------------------------------
#
# "/api" (recommended) = requests are proxied by the Next dev server to the
# Express backend on port 4000. Works on this PC AND on phones on the same
# Wi-Fi, with no CORS and no cross-origin cookie issues.
NEXT_PUBLIC_API_URL=/api
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Server-side only (never shipped to the browser): where /api/* is forwarded.
# API_PROXY_TARGET=http://localhost:4000
