# ---------------------------------------------------------------
# Backend environment (copy to backend/.env and FILL IN YOUR VALUES)
# Never commit the real .env file - it is listed in .gitignore.
# ---------------------------------------------------------------

# Runtime
NODE_ENV=development
PORT=4000

# Where the frontend runs (used for CORS and links in emails)
FRONTEND_URL=http://localhost:3000
# Public base URL of the backend itself (used for certificate verification links)
APP_BASE_URL=http://localhost:4000

# ---------------------------------------------------------------
# MySQL connection
# Your MySQL server is listening on port 3306 (checked from C:\ProgramData\MySQL\MySQL Server 8.0\my.ini).
# If your server uses a different port (e.g. 3310), change DATABASE_PORT only.
# ---------------------------------------------------------------
DATABASE_HOST=localhost
DATABASE_PORT=3306
DATABASE_NAME=salesforce_academy
DATABASE_USER=your_mysql_username
DATABASE_PASSWORD=your_mysql_password

# Optional: separate database used only by the automated tests
TEST_DATABASE_NAME=salesforce_academy_test

# Session cookie signing secret.
# Generate a strong value, for example (PowerShell):
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
SESSION_SECRET=replace_me_with_a_long_random_string_at_least_32_chars

# ---------------------------------------------------------------
# SMTP (certificate emails)
# Leave SMTP_ENABLED=false to keep everything else working.
# In development, SMTP_TRANSPORT=stream writes emails to
# backend/storage/mail/*.eml instead of sending them.
# ---------------------------------------------------------------
SMTP_ENABLED=false
SMTP_TRANSPORT=stream
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM="Salesforce Learning Academy <no-reply@localhost>"

# ---------------------------------------------------------------
# Protected administrator setup (used ONLY by `npm run create-admin`)
# Leave empty to be prompted interactively.
# ---------------------------------------------------------------
ADMIN_SETUP_EMAIL=
ADMIN_SETUP_PASSWORD=
