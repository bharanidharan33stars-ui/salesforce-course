{
  "name": "salesforce-learning-academy-backend",
  "version": "1.0.0",
  "private": true,
  "description": "Express + TypeScript REST API for Salesforce Learning Academy",
  "main": "dist/server.js",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "start": "node dist/server.js",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.test.json --noEmit",
    "migrate": "tsx src/db/migrate.ts",
    "seed": "tsx src/db/seed.ts",
    "create-admin": "tsx src/db/createAdmin.ts",
    "db:reset": "tsx src/db/reset.ts",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "argon2": "0.44.0",
    "cors": "2.8.6",
    "dotenv": "16.6.1",
    "express": "4.22.3",
    "express-rate-limit": "7.5.1",
    "express-session": "1.19.0",
    "helmet": "8.3.0",
    "mysql2": "3.24.6",
    "nodemailer": "7.0.13",
    "pdfkit": "0.20.2",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "4.17.23",
    "@types/express-session": "1.18.1",
    "@types/node": "^24.0.0",
    "@types/nodemailer": "^7.0.4",
    "@types/pdfkit": "^0.17.4",
    "@types/supertest": "^6.0.2",
    "supertest": "7.1.4",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "vitest": "3.2.7"
  }
}
